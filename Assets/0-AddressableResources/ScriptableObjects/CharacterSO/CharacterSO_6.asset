  characterName: "\uD53C\uC720"
  story: "\u2018\uAD50\uB2E8\u2019 \uC5D0 \uC18C\uC18D\uB41C \uD558\uD504 \uC5D8\uD504
    \uC18C\uB140. \uC778\uAC04\uACFC \uC5D8\uD504\uC758 \uD53C\uAC00 \uC11E\uC778
    \uADF8\uB140\uB294 \uD0DC\uC5B4\uB0A0 \uB54C\uBD80\uD130 \uD658\uC601 \uBC1B\uC9C0
    \uBABB\uD588\uACE0, \uAC13\uB09C \uC544\uAE30\uC77C \uC801\uC5D0 \uC131\uB2F9
    \uC55E\uC5D0 \uBC84\uB824\uC838 \uAD50\uB2E8\uC5D0 \uAC70\uB450\uC5B4\uC84C\uB2E4.
    \uC5B4\uB450\uC6B4 \uCD9C\uC0DD\uACFC \uC8FC\uBCC0\uC758 \uC2DC\uC120\uC5D0\uB3C4
    \uBD88\uAD6C\uD558\uACE0 \uC628\uAC74\uD30C \uC0AC\uC81C\uB4E4\uC758 \uC560\uC815\uC744
    \uBC1B\uACE0 \uC790\uB77C\uB098  \uBC1D\uACE0 \uB530\uB73B\uD55C \uC131\uACA9\uC744
    \uAC16\uACE0 \uC788\uC73C\uBA70, \uB204\uAD6C\uC640\uB3C4 \uC27D\uAC8C \uCE5C\uD574\uC9C0\uB294
    \uCE5C\uD654\uB825\uC744 \uAC00\uC84C\uB2E4.  \uC5D8\uD504 \uD2B9\uC720\uC758
    \uC815\uB839 \uB9C8\uBC95\uACFC \uAD81\uC220,  \uAD50\uB2E8\uC758 \uAC00\uB974\uCE68\uC73C\uB85C
    \uBC30\uC6B4 \uC2E0\uC131 \uB9C8\uBC95\uC73C\uB85C \uC784\uBB34\uC5D0\uC11C 
    \uB2E4\uC7AC\uB2E4\uB2A5\uD558\uAC8C \uC11C\uD3EC\uD2B8\uD558\uBA70, \uC0C1\uB0E5\uD55C
    \uD0DC\uB3C4, \uC544\uB984\uB2E4\uC6B4 \uC678\uBAA8\uB85C \uAD50\uB2E8 \uB0B4\uC5D0\uC11C 
    \uC740\uADFC\uD788 \uC9DD\uC0AC\uB791\uD558\uB294 \uC0AC\uB78C\uC774 \uB9CE\uC9C0\uB9CC
