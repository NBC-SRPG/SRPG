--- !u!114 &7902585419362112477
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6086250570801915724}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "UI \uC0C1\uD638\uC791\uC6A9 \uC124\uBA85(\uC0C1\uD638\uC791\uC6A9 \uC801\uC6A9\uD6C4
    \uC0AD\uC81C)\n1.  UpgradeInfo\uC758 \uC88C\uCE21\uC5D0\uB294 \uD604\uC7AC \uC7A5\uCC29\uC911\uC778
    \uC7A5\uBE44\uC758 \uC544\uC774\uCF58, \uC774\uB984, \uC131\uAE09\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.
    \uC6B0\uCE21\uC740 \uAC15\uD654\uC2DC \uC7A5\uCC29\uD558\uAC8C\uB420 \uC7A5\uBE44\uB97C
    \uD45C\uC2DC\uD569\uB2C8\uB2E4. CharacterSo\uC758 \uC7A5\uBE44\uBC30\uC5F4\uC744
    \uD1B5\uD574 \uD655\uC778\uD569\uB2C8\uB2E4. level\uC740 \uAC15\uD654\uC81C\uD55C\uB808\uBCA8\uC73C\uB85C 
    EquipSO\uC758 upgradeLevel\uC744 \uD45C\uC2DC\uD558\uB418, \uCE90\uB9AD\uD130\uC758
    \uD604\uC7AC\uB808\uBCA8\uC774 \uAC15\uD654\uC81C\uD55C\uB808\uBCA8\uBCF4\uB2E4
    \uB0AE\uC744\uACBD\uC6B0\uC5D0\uB9CC \uCD9C\uB825\uD569\uB2C8\uB2E4\n\n2. UpgradeStat\uC5D0\uB294
    \uC7A5\uBE44 \uAC15\uD654\uC2DC \uC2A4\uD0EF\uBCC0\uB3D9\uB7C9\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.
    \uD604\uC7AC\uC7A5\uBE44, \uB2E4\uC74C\uC7A5\uBE44\uC758 stat\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4.
    AdditionalChange\uB294 \uC7A5\uBE44\uC758 \uCD94\uAC00\uC635\uC158\uC744 \uB098\uD0C0\uB0C5\uB2C8\uB2E4.
    EquipSO\uAC00 \uAC00\uC9C4 addtional\uC774 null\uC774 \uC544\uB2C8\uB77C\uBA74
    \uCD9C\uB825\uD569\uB2C8\uB2E4.\n\n3. UpgradeMaterials\uB294 \uC7A5\uBE44\uAC15\uD654\uC5D0
    \uD544\uC694\uD55C \uC7AC\uB8CC\uC544\uC774\uD15C\uC758 \uBAA9\uB85D\uC785\uB2C8\uB2E4.
    EquipSO\uC758 upgradematerials \uB515\uC154\uB108\uB9AC\uAC00 \uD544\uC694\uC544\uC774\uD15C\uC758
    id\uC640 \uC694\uAD6C\uAC2F\uC218\uB97C \uAC00\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
    UpgradeMaterial\uC5D0  \uC544\uC774\uD15C\uC758 \uC544\uC774\uCF58, \uC774\uB984,
    \uBCF4\uC720\uAC2F\uC218/\uC694\uAD6C\uAC2F\uC218\uB97C \uD45C\uC2DC\uD558\uC5EC
    Grid\uC5D0 \uAC00\uC6B4\uB370 \uC815\uB82C\uD574\uC8FC\uC138\uC694. \uC7AC\uB8CC\uAC00
    \uBD80\uC871\uD558\uB2E4\uBA74 \uAC15\uD654\uBC84\uD2BC\uC744  \uBE44\uD65C\uC131\uD654\uD569\uB2C8\uB2E4\n\n4.
    Gold\uB294 EquipSO\uC758 \uD544\uC694\uACE8\uB4DC gold\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4.
    \uD604\uC7AC\uBCF4\uC720\uACE8\uB4DC\uAC00 \uB354  \uC801\uB2E4\uBA74  \uBD89\uC740\uC0C9
    \uD3F0\uD2B8\uB85C \uD45C\uC2DC\uD558\uACE0 \uAC15\uD654\uBC84\uD2BC\uC744 \uBE44\uD65C\uC131\uD654\uD569\uB2C8\uB2E4"
  m_isRightToLeft: 0
